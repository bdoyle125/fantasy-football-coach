# OpenAI API key used for all "Coach Frank" AI features (analyze-team, start-or-bench,
# matchup-preview, chat, season-summary). Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Fallback Sleeper league/owner IDs, used only when no active league is configured in
# Supabase yet (see GET/PUT /api/settings, or `npm run db:seed`).
SLEEPER_LEAGUE_ID=
SLEEPER_OWNER_ID=

# Supabase project used to persist which league/owner is "active". Service-role key only
# -- this backend never uses the anon key, and Row Level Security is intentionally off.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional -- defaults to 5000 if unset.
PORT=5000
